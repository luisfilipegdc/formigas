#!/bin/bash
# Publica o site do Bio no Bolso a partir do repo formigas (branch padrão).
# Pastas internas não vão para o ar (mesma regra do .vercelignore).
set -euo pipefail
SRC=/opt/site-src/formigas; DST=/srv/estudodebolso/www
if [ ! -d "$SRC/.git" ]; then mkdir -p /opt/site-src; git clone -q https://github.com/luisfilipegdc/formigas.git "$SRC"; fi
cd "$SRC"; git fetch -q origin; git reset -q --hard "origin/$(git rev-parse --abbrev-ref origin/HEAD | cut -d/ -f2-)"
mkdir -p "$DST"
rsync -a --delete --exclude='.git*' --exclude='.vercelignore' --exclude='vercel.json' --exclude='README.md' \
  --exclude='/docs/' --exclude='/design/' --exclude='/banco/' --exclude='/infra/' --exclude='/agentes/' --exclude='/ferramentas/' \
  "$SRC/" "$DST/"
echo "$(date '+%F %T') publicado $(git rev-parse --short HEAD)"
