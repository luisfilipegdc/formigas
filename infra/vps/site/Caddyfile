# Bio no Bolso: site estático (repo formigas), atrás da Cloudflare.
estudodebolso.com.br, www.estudodebolso.com.br {
	root * /srv/estudodebolso/www
	@interno path /web /web/* /docs /docs/* /design /design/* /banco /banco/* /infra /infra/* /agentes /agentes/*
	redir @interno / 302
	@www host www.estudodebolso.com.br
	redir @www https://estudodebolso.com.br{uri} 301
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@sw path /sw.js
	header @sw Cache-Control "no-cache"
	encode zstd gzip
	file_server
}
