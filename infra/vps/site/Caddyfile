# Bio no Bolso, atrás da Cloudflare.
#   /            → app Next.js (contêiner bionobolso-web)
#   /explorar/   → site estático dos bichos (repo formigas, publicado a cada 5 min)
#   endereços antigos do site estático → /explorar/ (links e QR codes impressos continuam valendo)
estudodebolso.com.br, www.estudodebolso.com.br {
	@www host www.estudodebolso.com.br
	redir @www https://estudodebolso.com.br{uri} 301

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	encode zstd gzip

	# service worker antigo da raiz: troca por um que se desliga
	handle /sw.js {
		header Cache-Control "no-cache"
		root * /srv/estudodebolso/raiz
		file_server
	}

	@antigo path /index.html /bicho3d.html /formiga.html /abelha.html /comparar.html /qr.html /manifest.webmanifest /css/* /js/* /img/* /vendor/* /som/*
	redir @antigo /explorar{uri} 301

	redir /explorar /explorar/ 308
	handle_path /explorar/* {
		@sw path /sw.js
		header @sw Cache-Control "no-cache"
		root * /srv/estudodebolso/www
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3100
	}
}

# Endereço provisório do app: agora redireciona para o domínio principal.
app.estudodebolso.com.br {
	redir https://estudodebolso.com.br{uri} 301
}

# Endereço extra (opcional) para o mesmo site estático de /explorar/, na raiz e com senha opcional.
# DNS (Cloudflare): registro A "bio" → IP da VPS, com proxy (nuvem laranja).
bio.estudodebolso.com.br {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	encode zstd gzip
	@sw path /sw.js
	header @sw Cache-Control "no-cache"
	# Para deixar privado (só com senha), descomente e gere a senha com: caddy hash-password
	# basic_auth {
	# 	familia COLE_AQUI_O_HASH
	# }
	root * /srv/estudodebolso/www
	file_server
}
